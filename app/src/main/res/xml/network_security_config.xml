<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: hanya HTTPS yang diizinkan -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Exception: izinkan HTTP hanya untuk IP development -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.2.35</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>       <!-- Android Emulator localhost -->
        <domain includeSubdomains="false">127.0.0.1</domain>      <!-- Localhost -->
    </domain-config>
</network-security-config>
