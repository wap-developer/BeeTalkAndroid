<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_loading"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Icon -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_primary">

        <ImageView
            android:id="@+id/iv_dialog_icon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_email"
            app:tint="@android:color/white" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/harabara"
        android:text="Email Verification"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/matcha"
        android:gravity="center"
        android:text="Verify your email or change to a new one"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- ============================================ -->
    <!-- STATE 1: Email display (readonly) + actions  -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/state_email_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Email display (readonly) -->
        <EditText
            android:id="@+id/et_dialog_email_display"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="12dp"
            android:drawableTint="#BDBDBD"
            android:enabled="false"
            android:fontFamily="@font/matcha"
            android:hint="email@example.com"
            android:inputType="none"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:textColor="#666666"
            android:textColorHint="#BFBFBF"
            android:textSize="15sp" />

        <!-- Buttons: Verify + Ubah Email -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_verify_send"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/harabara"
                android:text="Verify"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_switch_to_change"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/harabara"
                android:text="Ubah Email"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:backgroundTint="#F0F0F0"
                app:cornerRadius="14dp" />

        </LinearLayout>

        <!-- Close -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_close_dialog"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:fontFamily="@font/matcha"
            android:text="Close"
            android:textAllCaps="false"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            app:rippleColor="#22000000" />

    </LinearLayout>

    <!-- ============================================ -->
    <!-- LOADING OVERLAY (shown during API calls)     -->
    <!-- ============================================ -->
    <FrameLayout
        android:id="@+id/dialog_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:visibility="gone">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            app:indicatorColor="@color/primary"
            app:trackThickness="4dp" />

    </FrameLayout>

    <!-- ============================================ -->
    <!-- STATE 2: Change email form                   -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/state_change_email"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Editable email input -->
        <EditText
            android:id="@+id/et_new_email"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:drawableStart="@drawable/ic_email"
            android:drawablePadding="12dp"
            android:drawableTint="#DAA646"
            android:fontFamily="@font/matcha"
            android:hint="Enter new email address"
            android:inputType="textEmailAddress"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:textColor="#333333"
            android:textColorHint="#BFBFBF"
            android:textSize="15sp" />

        <!-- Buttons: Back + Save -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_to_view"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/harabara"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                app:backgroundTint="#F0F0F0"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_new_email"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/harabara"
                android:text="Simpan"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                app:backgroundTint="@color/primary"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ============================================ -->
    <!-- STATE 3: OTP verification                    -->
    <!-- ============================================ -->
    <LinearLayout
        android:id="@+id/state_otp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- OTP input -->
        <EditText
            android:id="@+id/et_otp_code"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_input_field"
            android:fontFamily="@font/harabara"
            android:gravity="center"
            android:hint="Enter 6-digit OTP"
            android:inputType="number"
            android:letterSpacing="0.1"
            android:maxLength="6"
            android:paddingEnd="20dp"
            android:paddingStart="20dp"
            android:textColor="@color/text_primary"
            android:textColorHint="#BFBFBF"
            android:textSize="22sp" />

        <!-- Verify OTP button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_verify_otp"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/harabara"
            android:text="Verify OTP"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp" />

        <!-- Resend OTP button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_resend_otp"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:fontFamily="@font/matcha"
            android:text="Resend OTP"
            android:textAllCaps="false"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="14dp"
            app:rippleColor="#22000000" />

    </LinearLayout>

</LinearLayout>
