<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F9F5EC">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- ============================================ -->
            <!-- TOP HEADER WITH GRADIENT                    -->
            <!-- ============================================ -->
            <RelativeLayout
                android:id="@+id/headerSection"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:background="@drawable/bg_login_header"
                app:layout_constraintTop_toTopOf="parent">

                <!-- Back button -->
                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="12dp"
                    android:contentDescription="Back"
                    android:src="@drawable/outline_arrow_back_24"
                    app:tint="#FFFFFF" />

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieTop"
                    android:layout_width="230dp"
                    android:layout_height="230dp"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="20dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:lottie_rawRes="@raw/regis" />


            </RelativeLayout>

            <!-- ============================================ -->
            <!-- REGISTER FORM CARD (overlaps header)        -->
            <!-- ============================================ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/registerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="-30dp"
                android:layout_marginEnd="20dp"
                android:elevation="12dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="28dp"
                app:layout_constraintTop_toBottomOf="@id/headerSection">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <!-- Header title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:fontFamily="@font/dacherry"
                        android:text="@string/register_title"
                        android:textColor="#000"
                        android:textSize="19dp"
                        android:textStyle="bold" />

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="20dp"
                        android:fontFamily="@font/matcha"
                        android:text="@string/register_subtitle"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp" />

                    <!-- ── Email ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="@string/email"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/outline_email_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:hint="@string/enter_email"
                        android:inputType="textEmailAddress"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Username ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="Username"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_person"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:hint="Choose a username"
                        android:inputType="text"
                        android:maxLength="30"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Full Name ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="@string/full_name"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_person"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:hint="@string/your_full_name"
                        android:inputType="textPersonName"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Password ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="@string/password"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/passwordLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#DAA646">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input_field"
                            android:drawableStart="@drawable/outline_lock_24"
                            android:drawablePadding="12dp"
                            android:drawableTint="#DAA646"
                            android:hint="@string/min_8_chars"
                            android:inputType="textPassword"
                            android:paddingStart="20dp"
                            android:paddingEnd="48dp"
                            android:textColor="#333333"
                            android:textColorHint="#BFBFBF"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ── Confirm Password ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="@string/confirm_password"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/confirmPasswordLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:passwordToggleTint="#DAA646">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_confirm_password"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_input_field"
                            android:drawableStart="@drawable/outline_lock_24"
                            android:drawablePadding="12dp"
                            android:drawableTint="#DAA646"
                            android:hint="@string/re_enter_password"
                            android:inputType="textPassword"
                            android:paddingStart="20dp"
                            android:paddingEnd="48dp"
                            android:textColor="#333333"
                            android:textColorHint="#BFBFBF"
                            android:textSize="15sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- ── Birth Date ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="@string/birth_date"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_birth_date"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawableEnd="@drawable/ic_calendar"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:focusable="false"
                        android:hint="@string/select_birth_date"
                        android:inputType="none"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Gender ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/harabara"
                        android:text="@string/gender"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <!-- Gender: hidden RadioGroup for logic -->
                    <RadioGroup
                        android:id="@+id/rg_gender"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <RadioButton
                            android:id="@+id/rb_male"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/male" />

                        <RadioButton
                            android:id="@+id/rb_female"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/female" />

                        <RadioButton
                            android:id="@+id/rb_other"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/other_reason" />
                    </RadioGroup>

                    <!-- Gender Visual Toggle Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btn_gender_male"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_gender_option"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/harabara"
                            android:gravity="center"
                            android:text="@string/male_symbol"
                            android:textColor="#DAA646"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_gender_female"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="3dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_gender_option"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/harabara"
                            android:gravity="center"
                            android:text="@string/female_symbol"
                            android:textColor="#DAA646"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_gender_other"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_gender_option"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/harabara"
                            android:gravity="center"
                            android:text="@string/other_symbol"
                            android:textColor="#DAA646"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- ── Bio ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="@string/bio_optional"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_bio"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/bg_input_field"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:gravity="top|start"
                        android:hint="@string/bio_hint"
                        android:inputType="textMultiLine"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="14dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Terms & Privacy ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/cb_agree_terms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:buttonTint="@color/primary"
                            android:minWidth="0dp"
                            android:minHeight="0dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/matcha"
                            android:text="@string/agree_to_the"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_terms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/matcha"
                            android:text="@string/terms"
                            android:layout_marginLeft="5dp"
                            android:layout_marginRight="5dp"
                            android:textColor="#DAA646"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/matcha"
                            android:text="@string/and_symbol"
                            android:textColor="#9E9E9E"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_privacy_policy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/matcha"
                            android:text="@string/privacy_policy"
                            android:textColor="#DAA646"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginLeft="5dp"
                            />

                    </LinearLayout>

                    <!-- ── Register Button ── -->
                    <Button
                        android:id="@+id/btn_register"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/shape_white"
                        android:elevation="6dp"
                        android:text="@string/create_account"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="19dp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="28dp" />

                    <!-- Loading state is handled by LoadingDialog -->

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ============================================ -->
            <!-- BOTTOM: Already have account link           -->
            <!-- ============================================ -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingBottom="60dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/registerCard">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/harabara"
                    android:text="@string/already_have_account_q"
                    android:textColor="#9E9E9E"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_login"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/matcha"
                    android:padding="4dp"
                    android:text="@string/signin_btn"
                    android:textColor="#DAA646"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>