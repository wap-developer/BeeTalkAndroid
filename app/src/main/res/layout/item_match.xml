<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Profile Photo Container -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_launcher_foreground" />
            
            <!-- Online Indicator -->
            <View
                android:id="@+id/view_online_dot"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="top|end"
                android:layout_margin="10dp"
                android:background="@drawable/bg_online_dot"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>

        <!-- Name & Age -->
        <TextView
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/full_name"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="@font/harabara"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Short Info / Location -->
        <TextView
            android:id="@+id/tv_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/location"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="@font/matcha"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Bio (Hidden by default or shown if important) -->
        <TextView
            android:id="@+id/tv_bio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/bio"
            android:textSize="10sp"
            android:textColor="@color/text_hint"
            android:fontFamily="@font/matcha"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <!-- Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send_message"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:text="@string/chat"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="#FFF8EC"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp"
            android:textColor="@color/primary"
            app:cornerRadius="19dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/outline_email_24"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            app:iconTint="@color/primary"
            android:elevation="0dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
