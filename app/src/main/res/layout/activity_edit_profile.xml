<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Modern Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="0dp"
        android:background="@android:color/white">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Edit Profile"
            app:titleTextAppearance="@style/TextAppearance.AppCompat.Widget.ActionBar.Title"
            app:titleTextColor="@color/text_primary"
            app:navigationIcon="@drawable/outline_arrow_back_24"
            app:navigationIconTint="@color/text_primary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0" />
            
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <!-- Edit Photo Profile Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp"
                        android:orientation="horizontal">

                        <View
                            android:layout_width="4dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/shape_rounded_orange" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Edit Photo Profile"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Primary Photo Preview (large) -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginBottom="16dp">

                        <de.hdodenhof.circleimageview.CircleImageView
                            android:id="@+id/iv_edit_primary_photo"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            app:civ_border_color="#F2BA3D"
                            app:civ_border_width="3dp" />

                        <!-- Camera overlay button -->
                        <FrameLayout
                            android:id="@+id/btn_change_primary_photo"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="2dp"
                            android:layout_marginStart="50dp"
                            android:background="@drawable/bg_circle_primary"
                            android:clickable="true"
                            android:elevation="4dp"
                            android:focusable="true">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_camera"
                                app:tint="@android:color/white" />

                        </FrameLayout>

                    </FrameLayout>

                    <!-- Subtitle -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/matcha"
                        android:gravity="center"
                        android:text="Tap the camera icon to change your profile photo"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Account & Info Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/card_background">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- ── Email ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:fontFamily="@font/harabara"
                            android:text="Email"
                            android:textColor="#7A7A7A"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_email_verified_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_verified"
                            android:fontFamily="@font/harabara"
                            android:paddingBottom="3dp"
                            android:paddingEnd="10dp"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:text="Verified"
                            android:textColor="#2E7D32"
                            android:textSize="11sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/btn_open_email_dialog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_badge_unverified"
                            android:fontFamily="@font/harabara"
                            android:paddingBottom="3dp"
                            android:paddingEnd="10dp"
                            android:paddingStart="10dp"
                            android:paddingTop="3dp"
                            android:text="Verify"
                            android:textColor="#E65100"
                            android:textSize="11sp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <EditText
                        android:id="@+id/et_email"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_email"
                        android:drawablePadding="12dp"
                        android:drawableTint="#BDBDBD"
                        android:enabled="false"
                        android:hint="Your email address"
                        android:inputType="none"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#999999"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Username ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="Username"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_username"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_person"
                        android:drawablePadding="12dp"
                        android:drawableTint="#BDBDBD"
                        android:enabled="false"
                        android:hint="Username"
                        android:inputType="none"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#999999"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Full Name ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="Full Name"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_person"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:hint="Your full name"
                        android:inputType="textPersonName"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Gender ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="Gender"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <AutoCompleteTextView
                        android:id="@+id/et_gender"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/baseline_favorite_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:hint="Select gender"
                        android:inputType="none"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Birth Date ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="Birth Date"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_birth_date"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:clickable="true"
                        android:drawableStart="@drawable/ic_calendar"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:focusable="false"
                        android:hint="Select birth date"
                        android:inputType="none"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Bio ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="Bio"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_bio"
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:gravity="top|start"
                        android:hint="Tell something about yourself..."
                        android:inputType="textMultiLine"
                        android:maxLength="500"
                        android:paddingBottom="14dp"
                        android:paddingEnd="20dp"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Hobbies ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="Hobbies"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_hobbies"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginBottom="16dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/baseline_favorite_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:hint="e.g. Reading, Traveling, Cooking"
                        android:inputType="text"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                    <!-- ── Dreams ── -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="6dp"
                        android:fontFamily="@font/harabara"
                        android:text="Dreams"
                        android:textColor="#7A7A7A"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/et_dreams"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/baseline_star_24"
                        android:drawablePadding="12dp"
                        android:drawableTint="#DAA646"
                        android:hint="e.g. Travel the world, Start a business"
                        android:inputType="text"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:textColor="#333333"
                        android:textColorHint="#BFBFBF"
                        android:textSize="15sp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/save_profile"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="@font/matcha"
                app:cornerRadius="30dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp"
                android:elevation="4dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Loading Progress -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="@color/primary"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
