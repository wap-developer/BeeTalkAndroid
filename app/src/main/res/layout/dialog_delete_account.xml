<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_loading"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Warning Icon -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_circle_danger">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/baseline_delete_forever_24"
            app:tint="@android:color/white" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/harabara"
        android:text="Delete Account?"
        android:textColor="#F44336"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- Warning message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/matcha"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="This will permanently delete your account, photos, matches, and all conversations. This action cannot be undone."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Confirmation input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/matcha"
        android:gravity="center"
        android:text="Type DELETE to confirm"
        android:textColor="@color/text_hint"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_confirm_delete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_input_field"
        android:fontFamily="@font/harabara"
        android:gravity="center"
        android:hint="DELETE"
        android:inputType="text"
        android:textColor="#F44336"
        android:textColorHint="#FFCDD2"
        android:textSize="16sp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel_delete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/harabara"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            app:backgroundTint="#F0F0F0"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_confirm_delete"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:enabled="false"
            android:fontFamily="@font/harabara"
            android:text="Delete"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            app:backgroundTint="#F44336"
            app:cornerRadius="14dp" />

    </LinearLayout>

</LinearLayout>
