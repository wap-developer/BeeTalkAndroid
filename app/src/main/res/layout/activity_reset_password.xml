<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F9F5EC">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- TOP HEADER WITH GRADIENT -->
        <RelativeLayout
            android:id="@+id/headerSection"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:background="@drawable/bg_login_header"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back button -->
            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_margin="12dp"
                android:src="@drawable/outline_arrow_back_24"
                app:tint="#FFFFFF"
                android:contentDescription="Back" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_centerInParent="true">

                <FrameLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:background="@drawable/circle_bg_white_alpha">

                    <ImageView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/outline_email_24"
                        android:layout_gravity="center"
                        android:contentDescription="Email code"
                        app:tint="#FFFFFF" />

                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_your_email"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/dacherry"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_6_digit_sent"
                    android:textSize="13sp"
                    android:textColor="#FFE9B0"
                    android:fontFamily="@font/matcha"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </RelativeLayout>

        <!-- FORM CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/verifyCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-30dp"
            android:elevation="12dp"
            app:cardCornerRadius="28dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toBottomOf="@id/headerSection">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:gravity="center">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/enter_6_digit_details"
                    android:textSize="13sp"
                    android:textColor="#9E9E9E"
                    android:fontFamily="@font/matcha"
                    android:textAlignment="center"
                    android:layout_marginBottom="28dp" />

                <!-- OTP Label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/verification_code_label"
                    android:textSize="13sp"
                    android:textColor="#7A7A7A"
                    android:textStyle="bold"
                    android:fontFamily="@font/harabara"
                    android:layout_marginBottom="6dp"
                    android:layout_marginStart="4dp" />

                <!-- OTP Input Field -->
                <EditText
                    android:id="@+id/et_otp"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:hint="0 0 0 0 0 0"
                    android:inputType="number"
                    android:maxLength="6"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:letterSpacing="0.4"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:textColor="#333333"
                    android:textColorHint="#BFBFBF"
                    android:layout_marginBottom="28dp" />

                <!-- Verify Button -->
                <Button
                    android:id="@+id/btn_verify_otp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/verify_code"
                    android:textColor="#FFFFFF"
                    android:textSize="16dp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/shape_white"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="28dp"
                    android:elevation="6dp" />

                <!-- Resend Code -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/didnt_receive_code"
                        android:textSize="13sp"
                        android:textColor="#9E9E9E"
                        android:fontFamily="@font/matcha" />

                    <TextView
                        android:id="@+id/tv_resend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/resend"
                        android:textColor="#DAA646"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/matcha"
                        android:padding="4dp" />

                </LinearLayout>

                <!-- Loading state is handled by LoadingDialog -->

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
