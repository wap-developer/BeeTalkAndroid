<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_loading"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="28dp">

    <!-- Lottie Heart Animation -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_match"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="8dp"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/heart_match" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_match_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/dacherry"
        android:text="It's a Match!"
        android:textColor="@color/primary"
        android:textSize="28sp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tv_match_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/matcha"
        android:gravity="center"
        android:text="You and someone liked each other"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- Matched User Photo -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/iv_match_photo"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="12dp"
        android:src="@drawable/ic_person"
        app:civ_border_color="@color/primary"
        app:civ_border_width="3dp" />

    <!-- Matched User Name -->
    <TextView
        android:id="@+id/tv_match_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/harabara"
        android:text="Name"
        android:textColor="@color/text_primary"
        android:textSize="20sp" />

    <!-- Send Message Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_send_message"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/harabara"
        android:text="Send Message"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="16sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="16dp" />

    <!-- Keep Swiping Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_keep_swiping"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:fontFamily="@font/matcha"
        android:text="Keep Swiping"
        android:textAllCaps="false"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="16dp"
        app:rippleColor="#22000000" />

</LinearLayout>
